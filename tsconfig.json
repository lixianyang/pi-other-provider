{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"lib": ["ES2023", "DOM"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"noEmit": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2023",
		"types": ["node"],
		"verbatimModuleSyntax": true
	},
	"include": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"]
}
